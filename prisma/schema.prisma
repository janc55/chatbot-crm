generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Lead {
  id              String        @id @default(uuid())
  phone           String
  fullName        String?       @map("full_name")
  careerInterest  String?       @map("career_interest")
  source          String        @default("unknown")
  status          LeadStatus    @default(NUEVO)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  isHandoverActive Boolean      @default(false) @map("is_handover_active")
  interactions    Interaction[]
  tenantId        String?       @map("tenant_id")
  tenant          Tenant?       @relation(fields: [tenantId], references: [id])

  @@map("leads")
  @@unique([phone, tenantId])
}


model Interaction {
  id          String          @id @default(uuid())
  leadId      String          @map("lead_id")
  direction   Direction
  messageType MessageType     @map("message_type")
  content     String
  templateKey String?         @map("template_key")
  usedAi      Boolean         @default(false) @map("used_ai")
  createdAt   DateTime        @default(now()) @map("created_at")
  lead        Lead            @relation(fields: [leadId], references: [id])

  @@map("interactions")
}

model Template {
  id                String   @id @default(uuid())
  key               String   @unique
  category          String
  language          String   @default("es")
  content           String
  attachments       String?  // JSON string or URL
  followUpSuggested Boolean  @default(false) @map("follow_up_suggested")
  embedding         Json?    // Vector de OpenAI almacenado como JSON array
  tenantId          String?  @map("tenant_id")
  tenant            Tenant?  @relation(fields: [tenantId], references: [id])
  
  @@map("templates")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  category    String   @default("general")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenantId    String?  @map("tenant_id")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  @@map("settings")
}

model Tenant {
  id                  String             @id @default(uuid())
  name                String
  domain              String?            @unique
  maxUsers            Int                @default(5) @map("max_users")
  maxWhatsappInstances Int               @default(1) @map("max_whatsapp_instances")
  subscriptionPlan    String             @default("FREE") @map("subscription_plan")
  createdAt           DateTime           @default(now()) @map("created_at")
  users               User[]
  leads               Lead[]
  templates           Template[]
  settings            Setting[]
  quickReplies        QuickReply[]
  whatsappInstances   WhatsappInstance[]

  @@map("tenants")
}

model WhatsappInstance {
  id          String   @id @default(uuid())
  name        String   @default("Main")
  sessionId   String   @unique @map("session_id")
  phoneNumber String?  @map("phone_number")
  status      String   @default("DISCONNECTED") // DISCONNECTED, CONNECTING, CONNECTED
  qrCode      String?  @map("qr_code") // Temporal storage if needed, or just for cache
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@map("whatsapp_instances")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String?  @map("full_name")
  role      Role     @default(AGENT)
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum Role {
  ADMIN
  AGENT
}

enum LeadStatus {
  NUEVO
  INTERESADO_BROCHURE
  INTERESADO_COSTOS
  PREINSCRITO
  INSCRITO
  DESCARTADO
  NECESITA_ASESOR
  PREINSCRIPCION_EN_PROCESO
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  MEDIA
  TEMPLATE
}

model QuickReply {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenantId  String?  @map("tenant_id")
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  @@map("quick_replies")
}
